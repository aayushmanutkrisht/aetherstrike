{
  "name": "aether-strike",
  "version": "1.5.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types tests/gestures.mjs",
    "postinstall": "node tools/prepare-vision.mjs",
    "prepare:vision": "node tools/prepare-vision.mjs",
    "test:level": "python tests/verify_level_geometry.py",
    "test:vision": "node --experimental-strip-types tests/model-bundle.mjs",
    "test:leaderboard": "node --experimental-strip-types tests/leaderboard.mjs",
    "test:preload": "node tests/preload-architecture.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
